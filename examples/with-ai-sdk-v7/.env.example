# 复制本文件为同目录的 .env.local，填写后重启开发服务。
# 当前聊天接口使用 OpenAI 兼容的 Chat Completions API，不限定服务商。
# 以下三项必填，须对应同一服务；模型需支持流式响应和工具调用。
# 密钥仅供服务端使用，不要添加 NEXT_PUBLIC_ 前缀或提交真实密钥。
OPENAI_API_KEY=

# 填写服务商提供的 API 基础地址，不包含 /chat/completions。
# 是否包含 /v1 等前缀，以服务商文档为准。
OPENAI_BASE_URL=

# 填写该服务商实际提供的模型 ID。
OPENAI_MODEL=

# 仅提交本示例文件；每位成员在自己的 .env.local 中配置。
# 旧版 DEEPSEEK_* 配置仅作兼容；新配置请使用上面三个变量。
