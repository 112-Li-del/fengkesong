# 团队同步：本模板随 Git 同步，真实密钥只填写同目录 .env.local。
# 首次使用或拉取更新后运行 pnpm env:sync（或 node scripts/sync-env.mjs）。
# 只补齐空白项，不覆盖已有配置；启动 pnpm dev 时也会自动执行。
# 当前聊天接口使用 OpenAI 兼容的 Chat Completions API，不限定服务商。
# 以下三项必填，须对应同一服务；模型需支持流式响应和工具调用。
# 密钥仅供服务端使用，不要添加 NEXT_PUBLIC_ 前缀或提交真实密钥。
OPENAI_API_KEY=

# 填写服务商提供的 API 基础地址，不包含 /chat/completions。
# 是否包含 /v1 等前缀，以服务商文档为准。
OPENAI_BASE_URL=

# 填写该服务商实际提供的模型 ID。
OPENAI_MODEL=

# 仅提交本示例文件；每位成员在自己的 .env.local 中配置。
# 旧版 DEEPSEEK_* 配置仅作兼容；新配置请使用上面三个变量。

# 高德地图：Web 端 JS API Key，与下一项安全密钥成对使用。
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
# 高德 Web 服务 Key，供助手 MCP 查询；不同于上面的 JS Key。
AMAP_WEB_SERVICE_KEY=
# 和风天气：控制台 > 设置，复制账号专属 API Host（如 abcxyz.xy.qweatherapi.com）。
# 以下配置仅在服务端读取；空着时使用 Open-Meteo，不提供分钟降水或生活指数。
QWEATHER_API_HOST=
# 控制台 > 项目 > 凭据 > 创建凭据 > API KEY。不要放进 NEXT_PUBLIC_*。
QWEATHER_API_KEY=
# 可选：使用 JWT 时填写有效令牌，与 API KEY 二选一；JWT 优先，过期需更新。
QWEATHER_JWT=
